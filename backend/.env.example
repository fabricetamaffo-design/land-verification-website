# ─── Database ────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/land_verification"

# ─── Authentication ───────────────────────────────────────────────────────────
# Secret key used to sign and verify JWT tokens — use a long random string in production
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# How long a JWT token stays valid (e.g. 7d, 24h, 60m)
JWT_EXPIRES_IN="7d"

# ─── Server ───────────────────────────────────────────────────────────────────
# Port the Express backend listens on
PORT=5000

# Set to "production" when deploying — disables dev-only features
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL of the frontend — used by Express to allow cross-origin requests
FRONTEND_URL="http://localhost:5173"
