FROM node:22-alpine

WORKDIR /app

COPY mobile/package.json mobile/package-lock.json ./mobile/
RUN cd mobile && npm ci

COPY shared ./shared
COPY mobile ./mobile

ARG EXPO_PUBLIC_API_URL=https://land-verification-backend-production.up.railway.app
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL

RUN cd mobile && npm run build:web

WORKDIR /app/mobile

CMD ["sh", "-c", "npm run start:web"]
